<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_maintenance_ext" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.maintenance.ext</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
             <xpath expr="//div[@id='multi_company']" position="before">
                    <h2>Maintenance Approvals Email</h2>
                    <div class="row mt16 o_settings_container" id="product_general_settings">
                        <div class="col-12 col-lg-6 o_setting_box" id="weight_uom_setting">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="maintenance_email_send" string="Send Email"/>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="maintenance_email_send" class="o_light_label"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_setting_right_pane" attrs="{'invisible': [('maintenance_email_send','=',False)]}">
                                <label for="maintenance_email_id_custom" string="Maintenance Email Template"/>
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="maintenance_email_id_custom" class="o_light_label" />
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </xpath>
        </field>
    </record>

<!--            Inherit Company-->
    <record id="view_res_company_form_custom" model="ir.ui.view">
        <field name="name">res.company.form11</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="website" position="after">
                <field name="maintenance_email_send" invisible="1"/>
                <field name="maintenance_email_id_custom" invisible="1"/>

            </field>
        </field>
    </record>

</odoo>
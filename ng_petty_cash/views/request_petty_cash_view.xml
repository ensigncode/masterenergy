<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <menuitem id="menu_petty_cash" name="Petty Cash" groups="ng_petty_cash.group_petty_cash_manager" sequence="10" />
        <menuitem id="menu_petty_cash_request" name="Petty Cash Request" parent="menu_petty_cash" sequence="20" />
        <record model="ir.ui.view" id="petty_cash_form_view">
            <field name="name">Petty Cash Request</field>
            <field name="model">request.petty.cash</field>
            <field name="arch" type="xml">
                <form string="Petty Cash Request">
                    <header>
                        <button name="submit" states="draft" string="Submit" type="object" class="oe_highlight" />
                        <button name="done" type="object" states="submitted" string="Approve" class="oe_highlight" groups="ng_petty_cash.group_petty_cash_manager" />
                        <button name="return_submit" states="submitted" string="Return" type="object" class="oe_highlight" groups="ng_petty_cash.group_petty_cash_manager" />
                        <field name="state" widget="statusbar" class="oe_highlight" statusbar_visible="draft,submitted,done" />
                    </header>
                    <sheet>
                        <div class="oe_title oe_inline">
                            <h1>
                                <field name="name" readonly="1" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="request_label" attrs="{'readonly':[('state','!=', 'draft')]}" />
                                <field name="petty_cashier" readonly="1" />
                                <field name="requested_date" attrs="{'readonly':[('state','!=', 'draft')]}" />
                                <field name="petty_cash_amount" attrs="{'readonly':[('state','!=', 'draft')]}" />
                            </group>
                            <group>
                                <field name="bank_statement" attrs="{'readonly':[('state', '!=', 'submitted')]}" />
                                <field name="approval_manager" readonly="1" />
                                <field name="approved_date" attrs="{'readonly':[('state', '!=', 'submitted')]}" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="petty_cash_tree_view">
            <field name="name">Petty Cash Request</field>
            <field name="model">request.petty.cash</field>
            <field name="arch" type="xml">
                <tree string="Petty Cash Request">
                    <field name="name" />
                    <field name="petty_cashier" />
                    <field name="petty_cash_amount" />
                    <field name="requested_date" />
                    <field name="approved_date" />
                    <field name="approval_manager" />
                </tree>
            </field>
        </record>
        <record forcecreate="1" id="request_id" model="ir.sequence">
            <field name="name">Request ID</field>
            <field name="code">name</field>
            <field name="padding">5</field>
            <field name="prefix">REQ/</field>
            <field name="implementation">no_gap</field>
        </record>
        <record model="ir.actions.act_window" id="petty_cash_request_action">
            <field name="name">Petty Cash Request</field>
            <field name="res_model">request.petty.cash</field>
            <field name="view_mode">form,tree</field>
            <field name="view_id" ref="petty_cash_tree_view" />
        </record>
        <!--Petty Cash sub menu-->
        <menuitem id="petty_cash_request" name="Petty Cash Request" parent="menu_petty_cash_request" sequence="10" action="petty_cash_request_action" />
    </data>
</odoo>